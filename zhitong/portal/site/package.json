{
  "name": "zhitong-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5327 --strictPort",
    "build": "vue-tsc --noEmit && vite build && vite build --ssr src/entry-server.ts --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5328 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write src tests scripts index.html vite.config.ts tsconfig.json README.md"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4",
    "vue-tsc": "3.3.13"
  }
}
